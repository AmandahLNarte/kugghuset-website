---
import globalCss from '../styles/global.css?url';
import '../styles/global.css';
import CookieConsent from '../components/CookieConsent.astro';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  schemaJson?: string;
  breadcrumbs?: { name: string; url: string }[];
}

const {
  title,
  description = 'Power BI konsult i Stockholm. Kugghuset hjälper ekonomichefer och controllers med business intelligence, datamodellering och interaktiva dashboards – 15+ års erfarenhet och 100+ kunder.',
  ogImage = '/images/reference-hands.png',
  ogType = 'website',
  noindex = false,
  schemaJson,
  breadcrumbs,
} = Astro.props;

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://kugghuset.se';
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const ogImageAbsolute = `${siteUrl}${ogImage}`;

function safeJson(obj: unknown): string {
  return JSON.stringify(obj)
    .replace(/</g, '\\u003c')
    .replace(/>/g, '\\u003e')
    .replace(/\//g, '\\u002f');
}

const organizationSchema = safeJson({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "ProfessionalService"],
      "@id": `${siteUrl}/#organization`,
      "name": "Kugghuset AB",
      "legalName": "Kugghuset AB",
      "url": siteUrl,
      "logo": {
        "@type": "ImageObject",
        "url": `${siteUrl}/images/logo-white-04.png`,
        "width": 512,
        "height": 512
      },
      "description": "Power BI-konsulter i Stockholm med 15+ års erfarenhet av business intelligence, datamodellering och interaktiva dashboards för ekonomichefer och controllers.",
      "foundingDate": "2013",
      "numberOfEmployees": { "@type": "QuantitativeValue", "value": 6 },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Sickla Strand 45",
        "postalCode": "131 34",
        "addressLocality": "Nacka",
        "addressRegion": "Stockholm",
        "addressCountry": "SE"
      },
      "geo": {
        "@type": "GeoCoordinates",
        "latitude": 59.302848,
        "longitude": 18.1228625
      },
      "hasMap": "https://www.google.com/maps/place/?q=place_id:ChIJt6F275F3X0YRvr3wmREX5R0",
      "review": [
        {
          "@type": "Review",
          "reviewBody": "The Kugghuset team always behave as a trusted business partner and has done magics with data which has tremendously improved our business intelligence and ability to make smart decisions.",
          "author": { "@type": "Person", "name": "Ulric Delamare", "jobTitle": "Group CFO" },
          "reviewRating": { "@type": "Rating", "ratingValue": 5, "bestRating": 5 }
        },
        {
          "@type": "Review",
          "reviewBody": "Kugghusets kreativa förmåga och breda kompetens inom BI möjliggjorde vår önskerapport.",
          "author": { "@type": "Person", "name": "Christer Hansson", "jobTitle": "Ekonomichef" },
          "reviewRating": { "@type": "Rating", "ratingValue": 5, "bestRating": 5 }
        },
        {
          "@type": "Review",
          "reviewBody": "Kugghuset kan faktiskt trolla med data. På nolltid bygger de avancerade och skräddarsydda BI-miljöer.",
          "author": { "@type": "Person", "name": "Mattias Elfgren", "jobTitle": "VD" },
          "reviewRating": { "@type": "Rating", "ratingValue": 5, "bestRating": 5 }
        },
        {
          "@type": "Review",
          "reviewBody": "Enkel koppling mellan ekonomisystem och rapportering i Excel. Snabbt och enkelt.",
          "author": { "@type": "Person", "name": "Lia Sandström" },
          "reviewRating": { "@type": "Rating", "ratingValue": 5, "bestRating": 5 }
        }
      ],
      "telephone": "+46704545531",
      "email": "info@kugghuset.se",
      "areaServed": [
        { "@type": "Country", "name": "Sweden" },
        { "@type": "City", "name": "Stockholm" }
      ],
      "knowsAbout": ["Power BI", "Business Intelligence", "Datamodellering", "SQL Server", "Microsoft Excel", "Datavisualisering", "Datalager"],
      "sameAs": [
        "https://www.linkedin.com/company/kugghuset-ab",
        "https://www.facebook.com/kugghuset"
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "Kugghuset",
      "publisher": { "@id": `${siteUrl}/#organization` },
      "inLanguage": "sv-SE"
    }
  ]
});
---
<!doctype html>
<html lang="sv">
  <head>
    <link rel="stylesheet" href={globalCss} />
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" hreflang="sv" href={canonicalURL} />
    <link rel="alternate" hreflang="x-default" href={canonicalURL} />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content="Kugghuset" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <title>{title}</title>

    <script type="application/ld+json" is:inline set:html={organizationSchema}></script>
    {schemaJson && <script type="application/ld+json" is:inline set:html={schemaJson}></script>}
    {breadcrumbs && <script type="application/ld+json" is:inline set:html={safeJson({
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Hem", "item": siteUrl },
        ...breadcrumbs.map((b, i) => ({
          "@type": "ListItem",
          "position": i + 2,
          "name": b.name,
          "item": `${siteUrl}${b.url}`
        }))
      ]
    })}></script>}

    <!-- Google tag (gtag.js) — Consent Mode v2, deferred until consent granted -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied'
      });
      var __gaLoaded = false;
      window.__loadGA = function () {
        if (__gaLoaded) return;
        __gaLoaded = true;
        gtag('js', new Date());
        gtag('config', 'G-N0ZK02QKVN');
        var _ga = document.createElement('script');
        _ga.async = true;
        _ga.src = 'https://www.googletagmanager.com/gtag/js?id=G-N0ZK02QKVN';
        document.head.appendChild(_ga);
      };
      try {
        if (localStorage.getItem('cookie_consent_v1') === 'granted') {
          gtag('consent', 'update', { analytics_storage: 'granted' });
          window.__loadGA();
        }
      } catch (e) {}
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="preload"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=optional"
      as="style"
      onload="this.onload=null;this.rel='stylesheet'"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,300;1,400&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=optional"
      />
    </noscript>

    <slot name="head" />
  </head>
  <body class="font-body">
    <CookieConsent />
    <slot />
  </body>
</html>
