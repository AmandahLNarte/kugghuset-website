---
export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  noindex?: boolean;
  schemaJson?: string;
}

const {
  title,
  description = 'Power BI konsult i Stockholm. Kugghuset hjälper ekonomichefer och controllers med business intelligence, datamodellering och interaktiva dashboards – 15+ års erfarenhet och 100+ kunder.',
  ogImage = '/images/reference-hands.png',
  ogType = 'website',
  noindex = false,
  schemaJson,
} = Astro.props;

const siteUrl = Astro.site?.href.replace(/\/$/, '') ?? 'https://kugghuset.se';
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;
const ogImageAbsolute = `${siteUrl}${ogImage}`;

const organizationSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": ["Organization", "ProfessionalService"],
      "@id": `${siteUrl}/#organization`,
      "name": "Kugghuset AB",
      "legalName": "Kugghuset AB",
      "url": siteUrl,
      "logo": {
        "@type": "ImageObject",
        "url": `${siteUrl}/images/logo-white-04.png`,
        "width": 512,
        "height": 512
      },
      "description": "Power BI-konsulter i Stockholm med 15+ års erfarenhet av business intelligence, datamodellering och interaktiva dashboards för ekonomichefer och controllers.",
      "foundingDate": "2013",
      "numberOfEmployees": { "@type": "QuantitativeValue", "value": 7 },
      "address": {
        "@type": "PostalAddress",
        "streetAddress": "Sickla Strand 45",
        "postalCode": "131 34",
        "addressLocality": "Nacka",
        "addressRegion": "Stockholm",
        "addressCountry": "SE"
      },
      "telephone": "+46704545531",
      "email": "konrad@kugghuset.se",
      "areaServed": [
        { "@type": "Country", "name": "Sweden" },
        { "@type": "City", "name": "Stockholm" }
      ],
      "knowsAbout": ["Power BI", "Business Intelligence", "Datamodellering", "SQL Server", "Microsoft Excel", "Datavisualisering", "Datalager"],
      "sameAs": [
        "https://www.linkedin.com/company/kugghuset-ab",
        "https://www.facebook.com/kugghuset"
      ]
    },
    {
      "@type": "WebSite",
      "@id": `${siteUrl}/#website`,
      "url": siteUrl,
      "name": "Kugghuset",
      "publisher": { "@id": `${siteUrl}/#organization` },
      "inLanguage": "sv-SE"
    }
  ]
});
---
<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbsolute} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content="Kugghuset" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbsolute} />

    <title>{title}</title>

    <script type="application/ld+json" is:inline set:html={organizationSchema}></script>
    {schemaJson && <script type="application/ld+json" is:inline set:html={schemaJson}></script>}

    <!-- Google tag (gtag.js) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-N0ZK02QKVN');
      var _ga = document.createElement('script');
      _ga.async = true;
      _ga.src = 'https://www.googletagmanager.com/gtag/js?id=G-N0ZK02QKVN';
      document.head.appendChild(_ga);
    </script>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,300;1,400;1,500&family=Hanken+Grotesk:wght@300;400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <style>
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; background: #0E1530; color: #F0EFFA; font-family: 'Hanken Grotesk', sans-serif; }
      ::selection { background: #5BA8E0; color: #0E1530; }
      ::-webkit-scrollbar { width: 8px; }
      ::-webkit-scrollbar-track { background: #0E1530; }
      ::-webkit-scrollbar-thumb { background: #2C3464; border-radius: 4px; }
      ::-webkit-scrollbar-thumb:hover { background: #5BA8E0; }
      a { color: inherit; text-decoration: none; }
      button { font-family: inherit; cursor: pointer; border: none; background: none; color: inherit; }
      @keyframes fadeUp {
        from { opacity: 0; transform: translateY(16px); }
        to   { opacity: 1; transform: translateY(0); }
      }
      @keyframes floatCluster {
        0%, 100% { transform: translateY(0) rotate(0deg); }
        50%       { transform: translateY(-10px) rotate(1.5deg); }
      }
      .animate-fade-up { animation: fadeUp 0.6s ease-out both; }
      .animate-float   { animation: floatCluster 6s ease-in-out infinite; }
    </style>
  </head>
  <body class="font-body">
    <slot />
  </body>
</html>
