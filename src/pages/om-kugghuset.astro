---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { team } from '../data/team';

const pageSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "AboutPage",
  "name": "Om Kugghuset",
  "url": "https://kugghuset.se/om-kugghuset",
  "description": "Om Kugghuset AB — grundat 2013, 200+ uppdrag, 6 BI- och AI-konsulter i Stockholm och Nacka.",
  "mainEntity": { "@id": "https://kugghuset.se/#organization" }
});
---
<Layout
  title="Om Kugghuset – BI & AI-konsulter sedan 2013 | Kugghuset"
  description="Kugghuset grundades 2013 med övertygelsen att svenska bolag förtjänar affärssystem som speglar verkligheten. Möt teamet bakom 200+ BI- och AI-uppdrag."
  schemaJson={pageSchema}
  breadcrumbs={[{ name: "Om oss", url: "/om-kugghuset" }]}
>
  <Header />

  <!-- hero -->
  <div class="relative bg-navy-dark pt-24 md:pt-32 pb-20 px-6 overflow-hidden">
    <div class="pointer-events-none absolute -left-20 top-0 w-96 h-96 rounded-full opacity-25" style="background:radial-gradient(circle,#E5B8CB 0%,transparent 70%);filter:blur(60px)"></div>
    <div class="relative max-w-7xl mx-auto text-center">
      <p class="font-mono text-xs tracking-[0.28em] uppercase text-fg/30 mb-4">Om oss</p>
      <h1 class="font-display font-light text-fg" style="font-size:clamp(2.5rem,6vw,5rem);line-height:1;letter-spacing:-0.03em;">
        Abrakadabra, <em style="letter-spacing:0.04em;font-style:italic;color:#E5B8CB;">simsalabim!</em>
      </h1>
      <p class="font-body mt-4 text-lg text-fg/70">
        Möt Kugghusets experter inom BI, AI & datatrolleri.
      </p>
      <p class="font-body mt-6 text-base text-fg/50 max-w-2xl mx-auto leading-relaxed">
        Vi levererar BI-lösningar som står stadigt på erfarenheten och springer snabbt på utveckling, för organisationer som vill ha både stabilitet och innovationskraft i sin dataplattform.
      </p>
    </div>
  </div>

  <!-- Teamet -->
  <section class="bg-navy-dark pb-20 px-6">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-2 lg:grid-cols-3 gap-4 md:gap-8">
        {team.map(member => (
          <a href={member.profilePath} class="group block">
            <div class="aspect-[3/4] overflow-hidden bg-fg/5 mb-4 relative">
              <img
                src={member.photo}
                alt={`${member.name}, ${member.roleSv} – Kugghuset`}
                class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 group-hover:scale-105"
                loading="lazy"
                decoding="async"
              />
              <div class="absolute inset-0 bg-navy/20 group-hover:bg-navy/0 transition-colors"></div>
            </div>
            <h2 class="font-display font-medium text-fg text-xl group-hover:text-pink transition-colors">{member.name}</h2>
            <p class="font-mono text-xs tracking-widest uppercase text-pink mt-0.5 mb-3">{member.roleSv}</p>
            <div class="flex flex-wrap gap-1.5">
              {member.skills.map(skill => (
                <span class="font-mono text-[10px] tracking-wide text-fg/60 border border-fg/20 px-2 py-0.5">{skill}</span>
              ))}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Om oss-innehåll -->
  <section class="bg-cream py-20 px-6">
    <div class="max-w-3xl mx-auto">

      <p class="font-body text-ink text-lg leading-relaxed mb-10">
        Kugghuset grundades 2013 av Konrad Leffler som en respons på det behov han såg fanns hos de ekonomichefer han då jobbade med: mer hållbara lösningar än de välbyggda Excel-modeller men som ingen vågade lita på fullt ut, Power BI-rapporter som byggs om varje kvartal och affärssystem som inte pratar med varandra. Med en unik kombination av finansiell domänkunskap och teknisk precision grundades Kugghuset för att lösa de problemen och skapa tillit till datan som tar företagen framåt.
      </p>

      <div class="grid sm:grid-cols-3 gap-6 mb-12">
        <div class="border-t-2 border-pink pt-4">
          <p class="font-mono text-[10px] tracking-widest uppercase text-navy/50 mb-2">Grundat</p>
          <p class="font-display font-light text-navy text-3xl">2013</p>
        </div>
        <div class="border-t-2 border-pink pt-4">
          <p class="font-mono text-[10px] tracking-widest uppercase text-navy/50 mb-2">Uppdrag</p>
          <p class="font-display font-light text-navy text-3xl">200+</p>
        </div>
        <div class="border-t-2 border-pink pt-4">
          <p class="font-mono text-[10px] tracking-widest uppercase text-navy/50 mb-2">Konsulter</p>
          <p class="font-display font-light text-navy text-3xl">6</p>
        </div>
      </div>

      <div class="mb-12">
        <p class="font-mono text-xs tracking-widest uppercase text-navy/50 mb-3">Vi tror på människan bakom siffran</p>
        <p class="font-body text-ink text-base leading-relaxed">
          Data är inte bara rader i ett system. Den berättar något om verksamheten, kunderna och framtiden. Vi hjälper företag att förstå den berättelsen — och använda den för att fatta bättre beslut.
        </p>
      </div>

      <div class="mb-12">
        <p class="font-mono text-xs tracking-widest uppercase text-navy/50 mb-5">Vad vi erbjuder</p>
        <ul class="space-y-3 font-body text-ink text-base">
          <li class="flex items-start gap-3"><span class="text-pink font-bold mt-0.5">—</span>Ett komplett BI-team som täcker hela kedjan</li>
          <li class="flex items-start gap-3"><span class="text-pink font-bold mt-0.5">—</span>Power BI-expertis i toppklass</li>
          <li class="flex items-start gap-3"><span class="text-pink font-bold mt-0.5">—</span>Automatiserade och hållbara datalösningar</li>
          <li class="flex items-start gap-3"><span class="text-pink font-bold mt-0.5">—</span>Felsökning, förbättringar och rådgivning</li>
          <li class="flex items-start gap-3"><span class="text-pink font-bold mt-0.5">—</span>Tydliga KPI:er och rapporter som alla kan förstå</li>
        </ul>
      </div>

      <div class="mb-12">
        <p class="font-mono text-xs tracking-widest uppercase text-navy/50 mb-3">Hur vi arbetar</p>
        <p class="font-body text-ink text-base leading-relaxed">Vi jobbar nära våra kunder, som en förlängning av deras team.</p>
      </div>

      <div class="mb-12">
        <p class="font-mono text-xs tracking-widest uppercase text-navy/50 mb-5">Våra värderingar</p>
        <ul class="space-y-3 font-body text-ink text-base mb-6">
          <li class="flex items-start gap-3"><span class="text-pink font-bold mt-0.5">—</span><span><strong>Enkelhet</strong> – BI ska inte vara komplicerat</span></li>
          <li class="flex items-start gap-3"><span class="text-pink font-bold mt-0.5">—</span><span><strong>Transparens</strong> – kunden ska alltid förstå vad vi gör och varför</span></li>
          <li class="flex items-start gap-3"><span class="text-pink font-bold mt-0.5">—</span><span><strong>Stabilitet</strong> – lösningen ska fungera varje dag, året runt</span></li>
          <li class="flex items-start gap-3"><span class="text-pink font-bold mt-0.5">—</span><span><strong>Utveckling</strong> – vi förbättrar löpande, både teknik och processer</span></li>
        </ul>
        <p class="font-body text-ink text-base leading-relaxed">Kugghuset är din partner när du vill ta klivet mot en mer datadriven organisation.</p>
      </div>

      <div>
        <p class="font-mono text-xs tracking-widest uppercase text-navy/50 mb-4">Verktyg & plattformar</p>
        <div class="flex flex-wrap gap-2">
          {['Power BI', 'Microsoft Fabric', 'Supabase', 'SQL Server', 'Python', 'React', 'FastAPI', 'Anthropic Claude SDK', 'Fortnox', 'Business Central'].map(tool => (
            <span class="font-mono text-[10px] tracking-wide text-navy border border-navy/20 px-3 py-1">{tool}</span>
          ))}
        </div>
      </div>

    </div>
  </section>

  <Footer />
</Layout>
