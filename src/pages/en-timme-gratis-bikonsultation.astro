---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const perks = [
  'Experter på BI',
  'Få en översikt',
  'Sekretessplikt',
  'Effektiv datavisualisering',
  'Inga krav',
  'Snabbt svar',
];
---
<Layout
  title="En timme gratis BI-konsultation | Kugghuset"
  description="Boka en timme kostnadsfri BI-konsultation med Kugghusets experter. Inga krav, snabbt svar."
>
  <Header />

  <div class="relative bg-navy-dark pt-24 md:pt-32 pb-20 px-6 overflow-hidden">
    <div class="pointer-events-none absolute left-1/2 top-0 w-[500px] h-[500px] -translate-x-1/2 rounded-full opacity-20" style="background:radial-gradient(circle,#5BA8E0 0%,transparent 70%);filter:blur(60px)"></div>
    <div class="relative max-w-7xl mx-auto text-center">
      <p class="font-mono text-xs tracking-[0.28em] uppercase text-fg/30 mb-4">Gratis konsultation</p>
      <h1 class="font-display font-light text-fg" style="font-size:clamp(2.5rem,6vw,5rem);line-height:1;letter-spacing:-0.03em;">
        Få en timme<br /><em style="letter-spacing:0.04em;font-style:italic;color:#E5B8CB;">kostnadsfri</em><br />BI-konsultation.
      </h1>
    </div>
  </div>

  <main class="bg-cream py-20 px-6">
    <div class="max-w-3xl mx-auto">

      <!-- perks -->
      <div class="grid sm:grid-cols-2 gap-3 mb-14">
        {perks.map(item => (
          <div class="flex items-center gap-3 bg-white border border-navy/10 px-5 py-4">
            <span class="text-pink-deep font-bold">✔</span>
            <span class="font-mono text-xs tracking-widest uppercase text-navy">{item}</span>
          </div>
        ))}
      </div>

      <!-- form -->
      <div class="bg-white border border-navy/10 p-10">
        <h2 class="font-display font-medium text-navy text-2xl mb-8 text-center">Boka din kostnadsfria timme</h2>
        <form id="bikon-form" action="/api/contact" method="POST" class="space-y-5" novalidate>
          <!-- Internal fields (not visible to users) -->
          <input type="hidden" name="_form" value="bikonsultation" />
          <input type="hidden" name="_lt" id="bikon-lt" value="" />
          <!-- Honeypot: real users never see or fill this -->
          <input
            type="text"
            name="_hp"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;"
          />

          <div>
            <label for="email" class="block font-mono text-xs tracking-widest uppercase text-navy/70 mb-2">E-postadress</label>
            <input id="email" type="email" name="email" placeholder="din@epost.se"
              class="w-full border border-navy/20 bg-cream text-ink text-sm px-4 py-3 focus:outline-none focus:border-navy transition-colors"/>
          </div>
          <div>
            <label for="phone" class="block font-mono text-xs tracking-widest uppercase text-navy/70 mb-2">Telefonnummer</label>
            <input id="phone" type="tel" name="telefon" placeholder="070-000 00 00"
              class="w-full border border-navy/20 bg-cream text-ink text-sm px-4 py-3 focus:outline-none focus:border-navy transition-colors"/>
          </div>
          <div>
            <label for="when" class="block font-mono text-xs tracking-widest uppercase text-navy/70 mb-2">När passar det dig?</label>
            <input id="when" type="text" name="nar_passar" placeholder="t.ex. tisdag eftermiddag"
              class="w-full border border-navy/20 bg-cream text-ink text-sm px-4 py-3 focus:outline-none focus:border-navy transition-colors"/>
          </div>
          <div>
            <label for="challenge" class="block font-mono text-xs tracking-widest uppercase text-navy/70 mb-2">Beskriv din utmaning</label>
            <textarea id="challenge" name="utmaning" rows="4"
              class="w-full border border-navy/20 bg-cream text-ink text-sm px-4 py-3 focus:outline-none focus:border-navy transition-colors resize-none"></textarea>
          </div>
          <p id="bikon-error" class="hidden font-mono text-xs text-red-600 bg-red-50 border border-red-200 px-4 py-3"></p>
          <button type="submit" id="bikon-submit"
            class="w-full bg-navy text-fg font-body font-semibold uppercase tracking-widest text-sm py-4 hover:bg-navy-deep transition-colors disabled:opacity-60 disabled:cursor-not-allowed">
            Skicka
          </button>
        </form>

        <script>
          (function () {
            // Stamp load time for timing check
            const lt = document.getElementById('bikon-lt') as HTMLInputElement | null;
            if (lt) lt.value = String(Date.now());

            const form = document.getElementById('bikon-form') as HTMLFormElement | null;
            const submitBtn = document.getElementById('bikon-submit') as HTMLButtonElement | null;
            const errorEl = document.getElementById('bikon-error');

            if (!form || !submitBtn) return;

            form.addEventListener('submit', async (e) => {
              e.preventDefault();

              // Require at least one contact method before hitting the server
              const emailVal = (form.querySelector('input[name="email"]') as HTMLInputElement)?.value.trim() ?? '';
              const phoneVal = (form.querySelector('input[name="telefon"]') as HTMLInputElement)?.value.trim() ?? '';
              if (!emailVal && !phoneVal) {
                if (errorEl) {
                  errorEl.textContent = 'Vänligen ange minst e-postadress eller telefonnummer så vi kan nå dig.';
                  errorEl.classList.remove('hidden');
                }
                return;
              }

              submitBtn.disabled = true;
              submitBtn.textContent = 'Skickar…';
              if (errorEl) errorEl.classList.add('hidden');

              try {
                const res = await fetch('/api/contact', {
                  method: 'POST',
                  body: new FormData(form),
                });

                if (res.ok) {
                  window.location.href = '/tack';
                  return;
                }

                const payload = await res.json().catch(() => ({})) as { error?: string };
                const ERROR_MESSAGES: Record<string, string> = {
                  contact_info_required: 'Vänligen ange minst e-postadress eller telefonnummer så vi kan nå dig.',
                  invalid_email:         'Kontrollera att e-postadressen är korrekt.',
                  bad_request:           'Formuläret kunde inte tolkas. Ladda om sidan och försök igen.',
                  email_failed:          'Meddelandet kunde inte skickas just nu. Försök igen om en stund eller ring oss direkt på +46 704 545 531.',
                };
                const msg = (payload.error && ERROR_MESSAGES[payload.error])
                  ?? 'Något gick fel. Försök igen eller ring oss direkt på +46 704 545 531.';
                if (errorEl) { errorEl.textContent = msg; errorEl.classList.remove('hidden'); }
              } catch {
                if (errorEl) {
                  errorEl.textContent = 'Nätverksfel. Kontrollera din anslutning och försök igen.';
                  errorEl.classList.remove('hidden');
                }
              } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Skicka';
              }
            });
          })();
        </script>
        <p class="font-mono text-[10px] text-ink/30 mt-5 text-center leading-relaxed">
          Dina uppgifter används enbart för att kontakta dig inför genomgången.<br />
          <a href="/dataskyddspolicy-kugghuset" class="underline hover:text-ink">Kugghusets dataskyddspolicy</a>
        </p>
      </div>

    </div>
  </main>

  <Footer />
</Layout>
