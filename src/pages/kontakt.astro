---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const contactSchema = JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Kontakta Kugghuset",
  "url": "https://kugghuset.se/kontakt",
  "description": "Kontakta Kugghusets BI-konsulter i Stockholm för Power BI-konsulting och business intelligence.",
  "mainEntity": { "@id": "https://kugghuset.se/#organization" }
});
---
<Layout
  title="Kontakt – Kugghuset BI-konsulter Stockholm"
  description="Kontakta Kugghusets BI-konsulter i Stockholm. Erfarna experter inom Power BI och business intelligence. Org.nr 556934-0531, Sickla Strand 45, Nacka."
  schemaJson={contactSchema}
  breadcrumbs={[{ name: "Kontakt", url: "/kontakt" }]}
>
  <Header />

  <div class="relative bg-navy-dark pt-24 md:pt-32 pb-20 px-6 overflow-hidden">
    <div class="pointer-events-none absolute -left-20 top-0 w-96 h-96 rounded-full opacity-30" style="background:radial-gradient(circle,#5BA8E0 0%,transparent 70%);filter:blur(60px)"></div>
    <div class="relative max-w-7xl mx-auto text-center">
      <p class="font-mono text-xs tracking-[0.28em] uppercase text-fg/30 mb-4">Kontakt</p>
      <h1 class="font-display font-light text-fg" style="font-size:clamp(2.5rem,6vw,5rem);line-height:1;letter-spacing:-0.03em;">
        Redo för<br /><em style="letter-spacing:0.04em;font-style:italic;color:#E5B8CB;">datatrolleri?</em>
      </h1>
    </div>
  </div>

  <main class="bg-cream py-20 px-6">
    <div class="max-w-7xl mx-auto">
    <div class="grid md:grid-cols-2 gap-8 md:gap-16">

      <!-- Kontaktinfo -->
      <div>
        <h2 class="font-display font-medium text-navy text-2xl mb-8">Kugghuset AB</h2>
        <div class="space-y-5 font-body text-sm text-ink">
          <div>
            <p class="font-mono text-xs tracking-widest uppercase text-navy/70 mb-1">Org.nr</p>
            <p>556934-0531</p>
          </div>
          <div>
            <p class="font-mono text-xs tracking-widest uppercase text-navy/70 mb-1">Besöksadress</p>
            <p>Sickla Strand 45<br/>131 34 Nacka</p>
          </div>
          <div>
            <p class="font-mono text-xs tracking-widest uppercase text-navy/70 mb-1">Telefon</p>
            <a href="tel:+46704545531" class="text-navy hover:underline">+46 704 545 531</a>
          </div>
          <div>
            <p class="font-mono text-xs tracking-widest uppercase text-navy/70 mb-1">E-post</p>
            <a href="mailto:info@kugghuset.se" class="text-navy hover:underline">info@kugghuset.se</a>
          </div>
        </div>
        <a href="/en-timme-gratis-bikonsultation"
          class="mt-8 inline-block bg-navy text-fg font-body font-semibold uppercase tracking-widest text-xs px-7 py-3.5 hover:bg-navy-deep transition-colors">
          Boka gratis BI-konsultation
        </a>
      </div>

      <!-- Formulär -->
      <div>
        <h2 class="font-display font-medium text-navy text-2xl mb-8">Skicka ett meddelande</h2>
        <form id="contact-form" action="/api/contact" method="POST" class="space-y-5" novalidate>
          <!-- Internal fields (not visible to users) -->
          <input type="hidden" name="_form" value="kontakt" />
          <input type="hidden" name="_lt" id="form-lt" value="" />
          <!-- Honeypot: real users never see or fill this -->
          <input
            type="text"
            name="_hp"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;"
          />

          <div>
            <label for="name" class="block font-mono text-xs tracking-widest uppercase text-navy/70 mb-2">Namn</label>
            <input id="name" type="text" name="namn" required
              class="w-full border border-navy/20 bg-white text-ink text-sm px-4 py-3 focus:outline-none focus:border-navy transition-colors"/>
          </div>
          <div>
            <label for="email" class="block font-mono text-xs tracking-widest uppercase text-navy/70 mb-2">E-postadress</label>
            <input id="email" type="email" name="email" required
              class="w-full border border-navy/20 bg-white text-ink text-sm px-4 py-3 focus:outline-none focus:border-navy transition-colors"/>
          </div>
          <div>
            <label for="message" class="block font-mono text-xs tracking-widest uppercase text-navy/70 mb-2">Meddelande</label>
            <textarea id="message" name="meddelande" rows="5" required
              class="w-full border border-navy/20 bg-white text-ink text-sm px-4 py-3 focus:outline-none focus:border-navy transition-colors resize-none"></textarea>
          </div>
          <p id="form-error" class="hidden font-mono text-xs text-red-600 bg-red-50 border border-red-200 px-4 py-3"></p>
          <button type="submit" id="form-submit"
            class="w-full bg-navy text-fg font-body font-semibold uppercase tracking-widest text-sm py-4 hover:bg-navy-deep transition-colors disabled:opacity-60 disabled:cursor-not-allowed">
            Skicka
          </button>
        </form>

        <script>
          (function () {
            // Stamp load time for timing check
            const lt = document.getElementById('form-lt') as HTMLInputElement | null;
            if (lt) lt.value = String(Date.now());

            const form = document.getElementById('contact-form') as HTMLFormElement | null;
            const submitBtn = document.getElementById('form-submit') as HTMLButtonElement | null;
            const errorEl = document.getElementById('form-error');

            if (!form || !submitBtn) return;

            form.addEventListener('submit', async (e) => {
              e.preventDefault();
              if (!form.checkValidity()) { form.reportValidity(); return; }

              submitBtn.disabled = true;
              submitBtn.textContent = 'Skickar…';
              if (errorEl) errorEl.classList.add('hidden');

              try {
                const res = await fetch('/api/contact', {
                  method: 'POST',
                  body: new FormData(form),
                });

                if (res.ok) {
                  window.location.href = '/tack';
                  return;
                }

                const payload = await res.json().catch(() => ({})) as { error?: string };
                const ERROR_MESSAGES: Record<string, string> = {
                  contact_info_required: 'Vänligen ange minst e-postadress.',
                  invalid_email:         'Kontrollera att e-postadressen är korrekt.',
                  bad_request:           'Formuläret kunde inte tolkas. Ladda om sidan och försök igen.',
                  email_failed:          'Meddelandet kunde inte skickas just nu. Försök igen om en stund eller ring oss direkt på +46 704 545 531.',
                };
                const msg = (payload.error && ERROR_MESSAGES[payload.error])
                  ?? 'Något gick fel. Försök igen eller ring oss direkt på +46 704 545 531.';
                if (errorEl) { errorEl.textContent = msg; errorEl.classList.remove('hidden'); }
              } catch {
                if (errorEl) {
                  errorEl.textContent = 'Nätverksfel. Kontrollera din anslutning och försök igen.';
                  errorEl.classList.remove('hidden');
                }
              } finally {
                submitBtn.disabled = false;
                submitBtn.textContent = 'Skicka';
              }
            });
          })();
        </script>
      </div>

    </div>

    <!-- Karta – full bredd, centrerad -->
    <div class="mt-16 border-t border-navy/10 pt-12">
      <p class="font-mono text-xs tracking-[0.28em] uppercase text-navy/70 mb-6 text-center">Hitta hit</p>
      <figure class="max-w-4xl mx-auto">
        <div class="relative">
          <iframe
            title="Kugghuset AB – Sickla Strand 45, 131 34 Nacka"
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2036.8093581843968!2d18.1227755!3d59.3027411!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x465f7791ef76a1b7%3A0x1de5171199f0bdbe!2sKugghuset!5e0!3m2!1sen!2sse!4v1779803060857!5m2!1sen!2sse"
            width="100%"
            height="440"
            style="border:0;"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            aria-label="Karta över Kugghusets kontor på Sickla Strand 45 i Nacka"
            class="w-full block"
          ></iframe>
          <!-- rosa overlay -->
          <div class="absolute inset-0 pointer-events-none" style="background:rgba(229,184,203,0.28);mix-blend-mode:multiply;"></div>
        </div>
        <figcaption class="mt-4 flex flex-wrap items-center justify-between gap-4">
          <address class="font-body text-sm text-ink not-italic">
            Kugghuset AB · Sickla Strand 45 · 131 34 Nacka
          </address>
          <a
            href="https://www.google.com/maps/place/?q=place_id:ChIJt6F275F3X0YRvr3wmREX5R0"
            target="_blank"
            rel="noopener noreferrer"
            class="font-mono text-xs tracking-widest uppercase text-navy hover:underline"
          >
            Vägbeskrivning i Google Maps →
          </a>
        </figcaption>
      </figure>
    </div>

    </div>
  </main>

  <Footer />
</Layout>
