---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { articles } from '../../data/articles';

const sorted = [...articles].sort((a, b) => b.date.localeCompare(a.date));
const allTags = ['Alla', ...new Set(sorted.flatMap(a => [a.category, ...a.tags]))];
const filters = allTags;
const authors = ['Alla', ...new Set(sorted.map(a => a.author))];
---

<Layout
  title="Insikter om Power BI, AI och Business Intelligence | Kugghuset"
  description="Insikter och nyheter från Kugghusets konsulter – om Power BI, AI-integrering, datamodellering och smart planering för ekonomichefer och controllers."
  breadcrumbs={[{ name: "Artiklar", url: "/artiklar" }]}
>
  <Header />

  <!-- Hero -->
  <section class="relative bg-navy-dark pt-24 md:pt-32 pb-16 px-6 overflow-hidden">
    <div class="pointer-events-none absolute -left-24 top-8 w-[560px] h-[560px] rounded-full opacity-20" style="background:radial-gradient(circle,#5BA8E0 0%,transparent 70%);filter:blur(90px)"></div>
    <div class="pointer-events-none absolute right-0 bottom-0 w-80 h-80 rounded-full opacity-15" style="background:radial-gradient(circle,#E5B8CB 0%,transparent 70%);filter:blur(60px)"></div>
    <div class="relative max-w-7xl mx-auto text-center">
      <h1
        class="font-display font-light text-fg"
        style="font-size:clamp(2.5rem,6vw,5.5rem);line-height:1.05;letter-spacing:-0.03em;"
      >
        Insikter, kunskap & nyheter<em style="letter-spacing:0.04em;font-style:italic;color:#B5CCE0;">.</em>
      </h1>
    </div>
  </section>

  <!-- Filter dropdown -->
  <div class="bg-navy-dark pb-10 md:pb-16 px-6">
    <div class="max-w-7xl mx-auto flex justify-center gap-3">

      <!-- Kategorier -->
      <div class="relative" id="filter-wrapper">
        <button
          id="filter-toggle"
          class="font-mono text-[11px] tracking-[0.2em] uppercase text-fg/60 border border-fg/20 px-5 py-2.5 hover:text-fg hover:border-fg/40 transition-colors flex items-center gap-3"
        >
          <span id="filter-label">Kategorier</span>
          <span id="filter-arrow" class="transition-transform duration-200">▾</span>
        </button>
        <div
          id="filter-menu"
          class="hidden absolute top-full left-1/2 -translate-x-1/2 mt-2 bg-navy-dark border border-fg/15 min-w-[200px] z-50 shadow-xl"
        >
          {filters.map((f, i) => (
            <button
              data-filter={f.toLowerCase()}
              class={`filter-btn w-full text-left font-mono text-[11px] tracking-[0.2em] uppercase px-5 py-3 transition-colors block ${
                i === 0 ? 'text-fg bg-fg/5' : 'text-fg/40 hover:text-fg hover:bg-fg/5'
              }`}
            >
              {f}
            </button>
          ))}
        </div>
      </div>

      <!-- Författare -->
      <div class="relative" id="author-wrapper">
        <button
          id="author-toggle"
          class="font-mono text-[11px] tracking-[0.2em] uppercase text-fg/60 border border-fg/20 px-5 py-2.5 hover:text-fg hover:border-fg/40 transition-colors flex items-center gap-3"
        >
          <span id="author-label">Författare</span>
          <span id="author-arrow" class="transition-transform duration-200">▾</span>
        </button>
        <div
          id="author-menu"
          class="hidden absolute top-full left-1/2 -translate-x-1/2 mt-2 bg-navy-dark border border-fg/15 min-w-[200px] z-50 shadow-xl"
        >
          {authors.map((a, i) => (
            <button
              data-author={a.toLowerCase()}
              class={`author-btn w-full text-left font-mono text-[11px] tracking-[0.2em] uppercase px-5 py-3 transition-colors block ${
                i === 0 ? 'text-fg bg-fg/5' : 'text-fg/40 hover:text-fg hover:bg-fg/5'
              }`}
            >
              {a}
            </button>
          ))}
        </div>
      </div>

    </div>
  </div>

  <!-- Article list -->
  <main class="bg-navy-dark">
    <div class="max-w-7xl mx-auto">
      {sorted.map((a, i) => {
        const imageLeft = i % 2 === 0;
        const href = a.fullText ? `/artiklar/${a.slug}` : '#';
        return (
          <article class="article-card grid md:grid-cols-2 group cursor-pointer mb-8" data-tags={[a.category, ...a.tags].map(t => t.toLowerCase()).join(',')} data-author={a.author.toLowerCase()}>

            <!-- Image -->
            <a
              href={href}
              class={`relative overflow-hidden block ${imageLeft ? 'md:order-1' : 'md:order-2'}`}
              style={`background: ${a.gradient}; min-height: 320px;`}
            >
              {a.image && (
                <img
                  src={a.image}
                  alt={a.imageAlt ?? a.title}
                  class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 ease-out group-hover:scale-110"
                  loading="lazy"
                  decoding="async"
                />
              )}
              {a.gridLines && !a.image && (
                <div
                  class="absolute inset-0"
                  style="background-image: linear-gradient(rgba(255,255,255,0.12) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.12) 1px, transparent 1px); background-size: 52px 52px;"
                />
              )}
            </a>

            <!-- Content -->
            <div
              class={`flex flex-col justify-between p-6 md:p-10 lg:p-14 ${
                imageLeft ? 'md:order-2' : 'md:order-1'
              }`}
            >
              <div>
                <div class="flex flex-wrap gap-2 mb-6">
                  <span class="font-mono text-[10px] tracking-[0.2em] uppercase text-fg/50 px-2.5 py-1">
                    {a.category}
                  </span>
                  {a.tags.map(tag => (
                    <span class="font-mono text-[10px] tracking-[0.2em] uppercase text-fg/35 px-2.5 py-1">
                      {tag}
                    </span>
                  ))}
                </div>

                <a href={href}>
                  <h2
                    class="font-display font-light text-fg leading-snug mb-5 group-hover:text-powder transition-colors duration-300 hover:text-powder"
                    style="font-size: clamp(1.5rem, 2.5vw, 2rem); letter-spacing: -0.02em;"
                  >
                    {a.title}
                  </h2>
                </a>

                <p class="font-body text-fg/50 text-base leading-relaxed max-w-xs">
                  {a.body}
                </p>
              </div>

              <div class="flex items-center justify-between mt-8 pt-6 gap-4">
                <p class="font-mono text-xs text-fg/25 tracking-widest">
                  {a.date} · {a.readTime}{a.author ? <> · <span class="whitespace-nowrap">{a.author}</span></> : ''}
                </p>
                <a
                  href={href}
                  class="font-mono text-xs tracking-widest uppercase text-fg/70 hover:text-fg transition-colors group-hover:text-powder whitespace-nowrap shrink-0"
                >
                  Läs artikeln →
                </a>
              </div>
            </div>
          </article>
        );
      })}
    </div>

  </main>

  <!-- Newsletter -->
  <section class="relative bg-navy-deep py-20 px-6 overflow-hidden">
    <div class="pointer-events-none absolute right-0 top-1/2 -translate-y-1/2 w-96 h-96 rounded-full opacity-15" style="background:radial-gradient(circle,#E5B8CB 0%,transparent 70%);filter:blur(60px)"></div>
    <div class="relative max-w-2xl mx-auto flex flex-col items-center text-center gap-8">
      <div>
        <p class="font-mono text-xs tracking-[0.28em] uppercase text-fg/30 mb-3">◇ Prenumerera</p>
        <h2 class="font-display font-light text-fg text-3xl md:text-4xl mb-4" style="letter-spacing:-0.025em;">
          Nyfiken på business intelligence, AI och Kugghusets resa i utvecklingen?
        </h2>
        <p class="font-body text-fg/60 text-sm leading-relaxed">
          Skriv upp dig på vårt nyhetsbrev!
        </p>
      </div>

      <div id="sib-form-container" class="sib-form-container w-full max-w-md">
        <div id="error-message" class="sib-form-message-panel hidden mb-4 px-4 py-3 font-body text-sm text-red-300 border border-red-500/40" style="background:rgba(180,30,30,0.2);">
          Prenumerationen misslyckades. Försök igen.
        </div>
        <div id="success-message" class="sib-form-message-panel hidden mb-4 px-4 py-3 font-body text-sm text-green-300 border border-green-500/40" style="background:rgba(20,120,60,0.2);">
          Tack! Du är nu prenumerant.
        </div>
        <div id="sib-container">
          <form
            id="sib-form"
            method="POST"
            action="https://e4325c5b.sibforms.com/serve/MUIFADSVhwXwo0RVkDgHgeZBcGTfUANbWXbT44TEDrT5w8GClR1Or1QakR-OxEQiUOGABHD2UxTY13YkQfNHML3MW_ea4kTNdhAeGK7br0azwMCIYsU1xDrSlLJo0WgCm7FCeHh_08e6otaX4UGnCzVPZF0_Owz8HYGUA9susHv1nO6dCV3DWBgMOJfxWdIiUFwlinzfSbiKpfPTbA=="
            data-type="subscription"
            class="flex flex-col sm:flex-row gap-3"
          >
            <input
              class="input flex-1 bg-white/5 border border-fg/20 text-fg placeholder-fg/40 font-body text-sm px-4 py-3 focus:outline-none focus:border-glow transition-colors"
              type="text"
              id="EMAIL"
              name="EMAIL"
              autocomplete="off"
              placeholder="din@epost.se"
              data-required="true"
              required
            />
            <button
              class="sib-form-block__button bg-glow text-white font-body font-semibold text-sm px-6 py-3 hover:bg-powder-deep transition-colors whitespace-nowrap"
              form="sib-form"
              type="submit"
            >
              Prenumerera →
            </button>
            <input type="text" name="email_address_check" value="" class="input--hidden" />
            <input type="hidden" name="locale" value="sv" />
          </form>
        </div>
      </div>
    </div>
  </section>

  <Footer />

  <script is:inline>
    window.REQUIRED_CODE_ERROR_MESSAGE = 'Please choose a country code';
    window.LOCALE = 'sv';
    window.EMAIL_INVALID_MESSAGE = window.SMS_INVALID_MESSAGE = "Ogiltig e-postadress. Kontrollera formatet och försök igen.";
    window.REQUIRED_ERROR_MESSAGE = "Det här fältet är obligatoriskt.";
    window.GENERIC_INVALID_MESSAGE = "Ogiltig information. Kontrollera formatet och försök igen.";
    window.INVALID_NUMBER = "Ogiltig information.";
    window.INVALID_DATE = "Ange ett giltigt datum.";
    window.REQUIRED_MULTISELECT_MESSAGE = 'Välj minst ett alternativ';
    window.translation = { common: { selectedList: '{quantity} list selected', selectedLists: '{quantity} lists selected', selectedOption: '{quantity} selected', selectedOptions: '{quantity} selected' } };
    var AUTOHIDE = Boolean(0);
  </script>
  <script is:inline defer src="https://sibforms.com/forms/end-form/build/main.js"></script>
</Layout>

<style>
  /* Reset any lingering Sibforms default styles */
  #sib-form-container, #sib-container, #sib-form {
    background: transparent !important;
    border: none !important;
    padding: 0 !important;
    margin: 0 !important;
    box-shadow: none !important;
  }
  .input--hidden { display: none !important; }

  .article-card.will-animate {
    opacity: 0;
    transform: translateY(40px);
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }
  .article-card.will-animate.visible {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  const cards = document.querySelectorAll<HTMLElement>('.article-card');

  // Scroll-in animation
  const observer = new IntersectionObserver(
    entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('visible');
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0, rootMargin: '0px 0px -60px 0px' }
  );
  cards.forEach((card, i) => {
    const rect = card.getBoundingClientRect();
    if (rect.top >= window.innerHeight) {
      card.classList.add('will-animate');
      card.style.transitionDelay = `${i * 0.05}s`;
      observer.observe(card);
    }
  });

  let activeFilter = 'alla';
  let activeAuthor = 'alla';

  function applyFilters() {
    cards.forEach(card => {
      const tags = card.dataset.tags ?? '';
      const author = card.dataset.author ?? '';
      const matchFilter = activeFilter === 'alla' || tags.split(',').includes(activeFilter);
      const matchAuthor = activeAuthor === 'alla' || author === activeAuthor;
      card.style.display = matchFilter && matchAuthor ? '' : 'none';
    });
  }

  function setupDropdown(
    toggleId: string, menuId: string, labelId: string, arrowId: string,
    btnClass: string, dataAttr: string, defaultLabel: string,
    onSelect: (val: string) => void
  ) {
    const toggle = document.getElementById(toggleId)!;
    const menu = document.getElementById(menuId)!;
    const label = document.getElementById(labelId)!;
    const arrow = document.getElementById(arrowId)!;
    const btns = document.querySelectorAll<HTMLElement>(`.${btnClass}`);

    toggle.addEventListener('click', () => {
      const open = !menu.classList.contains('hidden');
      menu.classList.toggle('hidden', open);
      arrow.style.transform = open ? '' : 'rotate(180deg)';
    });

    document.addEventListener('click', (e) => {
      if (!toggle.contains(e.target as Node) && !menu.contains(e.target as Node)) {
        menu.classList.add('hidden');
        arrow.style.transform = '';
      }
    });

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const val = (btn.dataset[dataAttr] ?? 'alla');
        label.textContent = val === 'alla' ? defaultLabel : btn.textContent?.trim() ?? defaultLabel;
        btns.forEach(b => { b.classList.remove('text-fg', 'bg-fg/5'); b.classList.add('text-fg/40'); });
        btn.classList.remove('text-fg/40');
        btn.classList.add('text-fg', 'bg-fg/5');
        menu.classList.add('hidden');
        arrow.style.transform = '';
        onSelect(val);
      });
    });
  }

  setupDropdown('filter-toggle', 'filter-menu', 'filter-label', 'filter-arrow',
    'filter-btn', 'filter', 'Kategorier',
    (val) => { activeFilter = val; applyFilters(); }
  );

  setupDropdown('author-toggle', 'author-menu', 'author-label', 'author-arrow',
    'author-btn', 'author', 'Författare',
    (val) => { activeAuthor = val; applyFilters(); }
  );
</script>
