# Microsoft Azure App Registration (app-only / client credentials)
# Required for sending email via Microsoft Graph API
AZURE_TENANT_ID=your-tenant-id-here
AZURE_CLIENT_ID=your-client-id-here
AZURE_CLIENT_SECRET=your-client-secret-here

# The Microsoft 365 mailbox that sends AND receives form submissions
# Must have the "Mail.Send" application permission granted in Azure AD
MAIL_SENDER=info@kugghuset.se
